# App Environment (development or production)
ENVIRONMENT=development

# JWT Secret Key for signing login tokens
SECRET_KEY=cozy_crochet_yarn_secret_key_1234567890_change_me_in_prod

# Database connection URL (defaults to async SQLite locally)
# DATABASE_URL=sqlite+aiosqlite:///./crochet.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/crochet_db

# Google client ID for Google Auth login (Optional)
GOOGLE_CLIENT_ID=

# Razorpay credentials for payment checkout flows (Optional - mock sandbox will run if missing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Gemini API key from Google AI Studio (Highly Recommended for AI Features)
GEMINI_API_KEY=
